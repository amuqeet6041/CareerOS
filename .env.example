# ==============================
# CareerOS - Root Environment Example
# Copy this to .env (root) if you want a single shared file. The backend and
# frontend read their OWN .env files: see backend/.env.example and
# frontend/.env.example for the authoritative lists.
# ==============================

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
DATABASE_URL=postgresql://user:password@localhost:5432/careeros
JWT_SECRET=replace-with-a-secure-random-secret
ENVIRONMENT=development
LLM_API_KEY=
JOBS_API_KEY=
MAX_RESUME_SIZE_MB=5

# AI resume intelligence (backend; see backend/.env.example). Empty provider
# means deterministic parsing only.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_RESUME_CHARS=30000
AI_TIMEOUT_SECONDS=30

# Never commit real values. This file only documents required variables.
# Generate a JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(64))"