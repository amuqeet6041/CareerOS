# ==============================
# CareerOS - Backend Environment Example
# Copy this to backend/.env before running the API (workspace .env is gitignored).
# ==============================

# Database connection used by the application AND by Alembic migrations
# (alembic/env.py resolves DATABASE_URL from the same place).
#
# Local development without a database server can use the on-disk SQLite dev
# database instead (already present at backend/careeros.db):
#   DATABASE_URL=sqlite:///./careeros.db
DATABASE_URL=postgresql://user:password@localhost:5432/careeros

# Signing secret for JWT access tokens (HS256). REQUIRED for any non-local
# run. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit a real value.
# In production (ENVIRONMENT=production) startup FAILS if this is empty or a
# placeholder. In development an explicit dev-only fallback is used instead.
JWT_SECRET=replace-with-a-secure-random-secret

# "development" | "production". Production refuses insecure JWT defaults and
# misconfigured AI settings.
ENVIRONMENT=development

# ==============================
# AI resume intelligence (Phase 3)
# ==============================
# AI_PROVIDER is empty by default: resumes are parsed deterministically and no
# external API is called. Set it to "openai" (any OpenAI-compatible
# /chat/completions endpoint via httpx) to enable AI-extracted structure, or
# "mock" for local development/tests (refused in production).
# AI failures never break uploads: the API falls back to deterministic parsing
# with analysis_status "ai_failed". No real key is required to run the tests.
#
# -------- Phase 7.3/8: Provider defaults (OpenAI / Gemini) ----------
# The same OpenAICompatibleProvider serves BOTH OpenAI and Gemini. The endpoint
# and model default to per-provider values resolved by the provider factory when
# AI_MODEL/AI_BASE_URL are left empty:
#
#   AI_PROVIDER=openai  -> https://api.openai.com/v1        / gpt-4o-mini
#   AI_PROVIDER=gemini  -> https://generativelanguage.googleapis.com/v1beta/openai/  / gemini-3.6-flash (recommended)
#
# NOTE: gemini-1.5-flash (and the gemini-2.x line) are RETIRED by Google — they
# return HTTP 404 on the OpenAI-compatible endpoint. The in-code default is
# gemini-3.6-flash, but models are retired without notice, so if the API starts
# returning 404 for an explicitly configured model, replace it with a currently
# available one.
#
# Set AI_BASE_URL explicitly (e.g. a custom proxy) to override the provider
# default for either provider:
#
#   AI_PROVIDER=gemini
#   AI_API_KEY=<your real Google key, never committed>
#   AI_MODEL=gemini-3.6-flash        (required; gemini-1.5-flash is retired)
#   AI_BASE_URL=                     (optional; falls back to the Gemini default)
#
# With AI_PROVIDER empty (default) analysis stays deterministic and no external
# API is called; with "mock" all AI calls are faked locally (refused in
# production). A blank/unset AI_API_KEY raises AIConfigurationError for a real
# provider rather than silently falling back.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Head of the resume text sent to the model (context budget cap).
AI_MAX_RESUME_CHARS=30000
AI_TIMEOUT_SECONDS=30

# -------- Bounded retry on transient provider failures --------
# Real Gemini/OpenAI traffic returns 429 (rate limited) and 503 (model
# overloaded) intermittently. These settings make the provider retry those
# instead of failing the request immediately.
# AI_MAX_RETRIES is the number of ADDITIONAL attempts after the first, so 2
# means at most 3 HTTP calls. Backoff is exponential from the base delay and
# capped at the max delay (0.5 / 1.0 / 2.0 ... 4.0 seconds).
# Permanent failures are never retried: invalid API key (401/403), malformed
# request (400/404/422), and unusable provider output. If every attempt fails,
# behaviour is unchanged from before — the upload succeeds with the
# deterministic parse and analysis_status "ai_failed".
# Values are clamped to 0..5 retries and 0..10 seconds.
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=0.5
AI_RETRY_MAX_DELAY_SECONDS=4.0

MAX_RESUME_SIZE_MB=5

# ==============================
# Live job search (JSearch via RapidAPI)
# ==============================
# Dashboard recommendations search live postings from the user's resume.
# Get a key: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# (subscribe to the free Basic plan). Empty disables live recommendations.
JOBS_API_KEY=
# Country code and location appended to every search ("Data Analyst in Pakistan").
# A preferred location in the user's profile overrides JOBS_DEFAULT_LOCATION.
JOBS_DEFAULT_COUNTRY=pk
JOBS_DEFAULT_LOCATION=Pakistan
# Each query costs one request from the monthly quota (free plan: ~200/month).
JOBS_MAX_QUERIES=3
# all | today | 3days | week | month
JOBS_DATE_POSTED=month
# Reuse a user's results until their resume changes or this many minutes pass.
JOBS_CACHE_MINUTES=360
# Without JOBS_API_KEY, recommendations fall back to Jobicy: real remote jobs,
# no key needed, kept only when open to the regions below (most Jobicy jobs
# are USA/UK-only). Set JOBS_FALLBACK_PROVIDER= (empty) to disable.
JOBS_FALLBACK_PROVIDER=jobicy
JOBICY_GEO=apac
JOBICY_ALLOWED_REGIONS=anywhere,worldwide,global,apac,asia,pakistan
JOBICY_CACHE_MINUTES=360
